{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/schemas/agent-activation/v1",
  "title": "Habitat Agent Activation Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "abi_version", "activation_id", "agent_id", "objective_ids", "wake_id", "system_generation_id", "capability_activation_set_id", "context_bundle_id", "capability_grant_ids", "isolation_profile_id", "resource_lease_id", "deadline"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "abi_version": {"const": "habitat.agent.v1"},
    "activation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "wake_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "system_generation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "capability_activation_set_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "context_bundle_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "capability_grant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "isolation_profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "resource_lease_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "deadline": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "maxLength": 128},
    "correlation_id": {"type": "string", "maxLength": 160}
  }
}

