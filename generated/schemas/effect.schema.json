{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/schemas/effect/v1",
  "title": "Habitat Effect Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "effect_id", "command_id", "activation_id", "agent_id", "objective_id", "capability", "operation", "target", "parameters_digest", "idempotency_key", "consequence_class", "expires_at", "evidence_requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "effect_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "activation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$", "maxLength": 200},
    "operation": {"type": "string", "minLength": 1, "maxLength": 160},
    "target": {"type": "object", "minProperties": 1},
    "parameters_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_precondition": {"type": "object"},
    "expected_result": {"type": "object"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
    "consequence_class": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
    "compensates_effect_id": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
