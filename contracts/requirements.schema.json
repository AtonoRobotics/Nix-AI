{
  "$id": "https://nix-ai.invalid/contracts/requirements-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_requirement_count": {
      "const": 40
    },
    "registry_id": {
      "const": "nix-ai-core-requirements-v2.0.1"
    },
    "requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "minLength": 1,
            "type": "string"
          },
          "boundary": {
            "minLength": 1,
            "type": "string"
          },
          "enforcement": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "evidence": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "failure": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Z]+-[0-9]{3}$",
            "type": "string"
          },
          "owner_packet": {
            "pattern": "^W(?:0[0-9]|1[0-3])$",
            "type": "string"
          },
          "shall": {
            "minLength": 1,
            "type": "string"
          },
          "source_authority": {
            "minLength": 1,
            "type": "string"
          },
          "source_reference": {
            "minLength": 1,
            "type": "string"
          },
          "trigger": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "shall",
          "trigger",
          "boundary",
          "failure",
          "enforcement",
          "evidence",
          "acceptance",
          "owner_packet",
          "source_authority",
          "source_reference"
        ],
        "type": "object"
      },
      "maxItems": 40,
      "minItems": 40,
      "type": "array"
    },
    "schema_version": {
      "const": 2
    },
    "source_authority": {
      "const": "contracts/v2.0.1/nix-ai-v2.0.1.contract.json"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "source_authority",
    "source_sha256",
    "expected_requirement_count",
    "requirements"
  ],
  "title": "Nix AI v2 requirement registry",
  "type": "object"
}
