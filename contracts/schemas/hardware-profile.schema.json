{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/schemas/hardware-profile/v1",
  "title": "Habitat Hardware Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "architecture", "kernel", "boot", "storage", "trust_root", "execution_runtimes", "capacity", "qualification_evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 160},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "architecture": {"type": "string", "enum": ["x86_64", "aarch64", "riscv64"]},
    "kernel": {"type": "object", "required": ["version", "digest", "bsp_ref"], "properties": {"version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bsp_ref": {"type": "string"}}},
    "boot": {"type": "object", "required": ["secure_boot", "automatic_rollback"], "properties": {"secure_boot": {"type": "boolean"}, "automatic_rollback": {"const": true}}},
    "storage": {"type": "object", "required": ["recovery_partition", "state_volume"], "properties": {"recovery_partition": {"type": "boolean"}, "state_volume": {"type": "string"}}},
    "trust_root": {"type": "string", "enum": ["TPM2", "TEE", "HSM", "SOFTWARE_DEGRADED"]},
    "gpu": {"type": "object"},
    "devices": {"type": "array", "items": {"type": "object"}},
    "execution_runtimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["NATIVE", "WASI", "OCI", "MICROVM", "REMOTE"]}},
    "capacity": {"type": "object", "minProperties": 1},
    "physical_safety_boundary_ref": {"type": "string"},
    "qualification_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}

