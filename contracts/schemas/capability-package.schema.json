{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/schemas/capability-package/v1",
  "title": "Habitat Capability Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "artifact", "execution", "provides", "requires", "resources", "isolation", "state", "activation", "compatibility", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "publisher", "signature_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$", "maxLength": 200},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 200},
        "signature_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "artifact": {"type": "object", "required": ["immutable_ref"], "properties": {"immutable_ref": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entrypoint"],
      "properties": {
        "kind": {"type": "string", "enum": ["NATIVE_SERVICE", "CORDIS", "WASI_COMPONENT", "OCI", "MICROVM", "REMOTE", "PHYSICAL_ADAPTER"]},
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "provides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "requires": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "resources": {"type": "object"},
    "isolation": {"type": "object", "required": ["profile_id"], "properties": {"profile_id": {"type": "string", "minLength": 1, "maxLength": 160}}},
    "state": {"type": "object", "required": ["mode", "schema_version", "rollback"], "properties": {"mode": {"enum": ["STATELESS", "EPHEMERAL", "PERSISTENT"]}, "schema_version": {"type": "string"}, "rollback": {"enum": ["NOT_REQUIRED", "BACKWARD_COMPATIBLE", "RESTORE_REQUIRED", "IRREVERSIBLE_PROHIBITED"]}}},
    "activation": {"type": "object", "required": ["health_contract", "live_verification_contract", "drain_policy"], "properties": {"health_contract": {"type": "string"}, "live_verification_contract": {"type": "string"}, "drain_policy": {"enum": ["DRAIN", "MIGRATE", "TERMINATE_AND_RECONCILE"]}}},
    "compatibility": {"type": "object", "required": ["agent_abi", "hardware_profiles"], "properties": {"agent_abi": {"type": "string"}, "hardware_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "provenance": {"type": "object", "required": ["source_lock_digest", "sbom_ref", "build_evidence_ref"], "properties": {"source_lock_digest": {"type": "string"}, "sbom_ref": {"type": "string"}, "build_evidence_ref": {"type": "string"}}}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$", "maxLength": 200},
        "contract": {"type": "string", "minLength": 1, "maxLength": 512},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    }
  }
}
