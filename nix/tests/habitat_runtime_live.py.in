import boto3
import hashlib
import json
import pathlib
import pwd
import socket
import struct
import subprocess
import time
import uuid

SYSTEMCTL = "@systemctl@"
SYSTEMD_RUN = "@systemd_run@"
OPERATOR = "@operator@"
PSQL = "@psql@"
RUNUSER = "@runuser@"
RUN = "/run/habitat"

def recv_exact(client, size):
    wire = b""
    while len(wire) < size:
        chunk = client.recv(size - len(wire))
        if not chunk:
            raise ConnectionError("transport closed during framed message")
        wire += chunk
    return wire

def query(component, request):
    if component in ("authority", "effects", "runtime"):
        return principal_query("operator", component, request, "habitat-operator")
    path = f"{RUN}/{component}/{component}.sock"
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(10)
        client.connect(path)
        payload = json.dumps(request, separators=(",", ":")).encode()
        client.sendall(struct.pack("!I", len(payload)) + payload)
        size = struct.unpack("!I", recv_exact(client, 4))[0]
        if size > 1024 * 1024:
            raise ValueError("oversized transport response")
        return json.loads(recv_exact(client, size))

def service(action, name):
    subprocess.run([SYSTEMCTL, action, name], check=True)

def principal_query(principal, component, request, uid=None):
    unit = (f"habitat-{principal}" if principal in ("operator", "reviewer")
            else f"habitat-{principal}-{uuid.uuid4().hex}")
    command = [SYSTEMD_RUN, "--quiet", "--wait", "--pipe", "--collect",
               "--unit", unit]
    if uid:
        account = pwd.getpwnam(uid)
        command += ["--uid", str(account.pw_uid), "--gid", str(account.pw_gid)]
    command += [OPERATOR, "--client", f"{RUN}/{component}/{component}.sock", request]
    return subprocess.check_output(command, text=True).strip()

def wait_ready(name, timeout=60, uid=None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            response = (principal_query(f"{name}-ready", name, "STATUS", uid)
                        if uid else query(name, "STATUS"))
            if response.startswith("READY"):
                return
        except (OSError, subprocess.CalledProcessError):
            pass
        time.sleep(0.2)
    raise RuntimeError(f"{name} did not become ready")

def peer_is_rejected(principal, component, request, uid):
    try:
        principal_query(principal, component, request, uid)
    except subprocess.CalledProcessError:
        return True
    return False

def pg(sql):
    return subprocess.check_output(
        [RUNUSER, "--user", "habitat-verifier", "--", PSQL, "-XqAt",
         "postgresql:///habitat-state?host=/run/postgresql", "-c", sql],
        text=True).strip()

def wait_pg(timeout=30):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            if pg("SELECT 1") == "1":
                return
        except subprocess.CalledProcessError:
            pass
        time.sleep(0.2)
    raise RuntimeError("PostgreSQL did not become queryable")

def pg_effects(objective):
    assert objective.startswith("objective:qemu-") and "'" not in objective
    rows = pg("SELECT h.canonical_event::text FROM effect_records r "
              "JOIN LATERAL (SELECT canonical_event FROM effect_transition_history "
              "WHERE effect_id=r.effect_id ORDER BY effect_version DESC LIMIT 1) h ON true "
              f"WHERE r.objective_id='{objective}' ORDER BY r.effect_id")
    snapshots = [json.loads(line) for line in rows.splitlines() if line]
    return {item["record"]["effect_id"]: item for item in snapshots}

def authority_snapshot():
    snapshot = pg("SELECT snapshot::text FROM authority_bindings "
                  "WHERE binding_id='authority:runtime'")
    assert snapshot
    return json.loads(snapshot)

def authority_quota():
    return dict(authority_snapshot()["quota_usage"])

def wait_effect(objective, effect_id, predicate, timeout=60):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            last = pg_effects(objective)
            if predicate(last):
                return last
        except (OSError, json.JSONDecodeError):
            pass
        time.sleep(0.2)
    raise AssertionError(f"effect {effect_id} did not reconcile: {last}")

def prepare(label):
    objective = "objective:qemu-" + label
    deadline = time.monotonic() + 60
    last = None
    while time.monotonic() < deadline:
        try:
            last = query("runtime", "PREPARE " + objective)
            if last == "ACCEPTED":
                return objective
        except OSError as error:
            last = repr(error)
        time.sleep(0.2)
    raise AssertionError(f"prepare {label} failed: {last}")

wait_ready("runtime")
# Runtime readiness already includes the state dependency.  A transient unit
# must not be able to borrow habitat-runtime's UID to query state directly;
# exact fixed-unit authentication intentionally rejects that probe.
wait_ready("authority")
wait_ready("effects")
direct = query("state", "RECORD_EFFECT objective:qemu-forged")
assert direct == {"status": "unauthorized", "code": "UNAUTHORIZED"}

now = int(time.time())
forged_request = {
    "schema_version":"2.0", "request_id":"effect:forged",
    "caller_service_id":"service:runtime", "machine_id":"machine:local",
    "service_id":"service:runtime", "activation_id":"activation:runtime",
    "objective_id":"objective:qemu-forged", "capability":"runtime.effect",
    "operation":"commit", "target":"objective:qemu-forged",
    "generation":"generation:current", "state_version":"state:current",
    "requested_at":now,
}
forged = json.loads(query("authority", json.dumps(forged_request)))
assert forged["allowed"] is False and forged["code"] == "UNAUTHORIZED"

provider_objective = "objective:qemu-provider-" + uuid.uuid4().hex
provider_request = dict(forged_request)
provider_request.update({
    "request_id":"effect:" + provider_objective,
    "caller_service_id":"service:runtime",
    "objective_id":provider_objective, "target":provider_objective,
    "requested_at":int(time.time()),
})
provider = json.loads(query("effects", json.dumps({
    "schema_version":"2.0", "caller_service_id":"service:operator",
    "command_id":"effect:" + provider_objective,
    "objective_id":provider_objective, "provider_id":"forged-provider",
    "parameters_digest":"sha256:" + hashlib.sha256(provider_objective.encode()).hexdigest(),
    "idempotency_key":"effect:" + provider_objective,
    "authority_request":provider_request,
})))
assert provider["code"] == "UNAUTHORIZED"

operator_borrow = dict(forged_request)
operator_borrow.update({"request_id":"effect:operator-borrow",
                        "caller_service_id":"service:runtime",
                        "requested_at":int(time.time())})
borrowed = json.loads(principal_query(
    "operator", "authority", json.dumps(operator_borrow), "habitat-operator"))
assert borrowed["allowed"] is False
assert peer_is_rejected(
    "wrong-unit", "authority", json.dumps(operator_borrow), "habitat-runtime")

objective = prepare("success")
completion = query("runtime", "RESUME " + objective)
if completion != "COMPLETED":
    authority_state = pathlib.Path("/var/lib/habitat/authority/authority.json")
    effect_state = pathlib.Path("/var/lib/habitat/effects/ledger.json")
    raise AssertionError(json.dumps({
        "completion":completion,
        "authority":json.loads(authority_state.read_text()) if authority_state.exists() else None,
        "effects":json.loads(effect_state.read_text()) if effect_state.exists() else None,
        "postgresql":query("runtime", "INSPECT " + objective),
        "units":subprocess.check_output([
            SYSTEMCTL, "is-active", "habitat-authority.service",
            "habitat-effects.service", "habitat-state.service"
        ], text=True).splitlines(),
        "journal":subprocess.check_output([
            "journalctl", "--no-pager", "-n", "80",
            "-u", "habitat-runtime.service", "-u", "habitat-effects.service"
        ], text=True),
    }, sort_keys=True))
state = json.loads(query("runtime", "INSPECT " + objective))
assert state["objective_state"] == "SATISFIED"
assert len(state["effects"]) == 1 and state["effects"][0]["state"] == "COMMITTED"
assert state["guard"]["ready"] is True and state["guard"]["effect_count"] == 1
evidence_ref = state["effects"][0]["evidence_ref"]
assert evidence_ref.startswith("s3://habitat-evidence/sha256/")
effect_id = state["effects"][0]["effect_id"]
ledger = pg_effects(objective)
assert len(ledger[effect_id]["attempts"]) == 1
pg_projection = json.loads(pg(
    "SELECT row_to_json(x)::text FROM (SELECT effect_id,activation_id AS objective_id,"
    "request_digest,state,evidence_ref FROM durable_effects WHERE effect_id='" +
    effect_id + "') x"))
assert pg_projection["objective_id"] == objective
assert pg_projection["state"] == "COMMITTED"
verifier_write = subprocess.run(
    [RUNUSER, "--user", "habitat-verifier", "--", PSQL, "-XqAt",
     "postgresql:///habitat-state?host=/run/postgresql", "-c",
     "UPDATE durable_effects SET state='REJECTED' WHERE effect_id='" +
     effect_id + "'"], capture_output=True, text=True)
assert verifier_write.returncode != 0
store_config = json.loads(pathlib.Path(
    "/run/habitat-credentials/verifier-object-store-url").read_text())
admin_store_config = json.loads(pathlib.Path(
    "/run/habitat-credentials/object-store-url").read_text())
s3 = boto3.client("s3", endpoint_url=store_config["endpoint"],
                  aws_access_key_id=store_config["access_key"],
                  aws_secret_access_key=store_config["secret_key"],
                  region_name=store_config["region"])
admin_s3 = boto3.client("s3", endpoint_url=admin_store_config["endpoint"],
                        aws_access_key_id=admin_store_config["access_key"],
                        aws_secret_access_key=admin_store_config["secret_key"],
                        region_name=admin_store_config["region"])
evidence_key = "sha256/" + evidence_ref.rsplit("/", 1)[-1]
evidence_bytes = s3.get_object(Bucket=store_config["bucket"],
                               Key=evidence_key)["Body"].read()
assert hashlib.sha256(evidence_bytes).hexdigest() == evidence_ref.rsplit("/", 1)[-1]
evidence_record = json.loads(evidence_bytes)
assert set(evidence_record) == {
    "schema_version", "producer", "subject", "operation", "source", "payload"}
assert evidence_record["schema_version"] == "1"
assert evidence_record["producer"] == "service:effects"
assert evidence_record["subject"] == effect_id
assert evidence_record["operation"] == "effect.transition"
evidence_payload = evidence_record["payload"]
assert set(evidence_payload) == {
    "transition_id", "effect_id", "objective_id", "request_digest",
    "previous_state", "new_state", "provider_id", "attempt_identity",
    "external_ref", "provider_observation", "disposition"}
assert evidence_payload["effect_id"] == effect_id
assert evidence_payload["disposition"] == "OBSERVED_SUCCEEDED"
assert evidence_payload["objective_id"] == objective
assert evidence_payload["request_digest"] == pg_projection["request_digest"]
assert evidence_payload["new_state"] == "OBSERVED_SUCCEEDED"
assert evidence_record["source"] == evidence_payload["external_ref"]
verifier_write_denied = False
try:
    s3.put_object(Bucket=store_config["bucket"], Key=evidence_key,
                  Body=evidence_bytes + b"forbidden")
except Exception:
    verifier_write_denied = True
assert verifier_write_denied
admin_s3.put_object(Bucket=store_config["bucket"], Key=evidence_key,
                    Body=evidence_bytes + b"tamper")
tampered = s3.get_object(Bucket=store_config["bucket"],
                         Key=evidence_key)["Body"].read()
assert hashlib.sha256(tampered).hexdigest() != evidence_ref.rsplit("/", 1)[-1]
admin_s3.put_object(Bucket=store_config["bucket"], Key=evidence_key,
                    Body=evidence_bytes,
                    Metadata={"sha256":evidence_ref.rsplit("/", 1)[-1]})
assert state["effect_state"] == "COMMITTED"
assert state["evidence_ref"] == evidence_ref
quota_before = authority_quota()
replayed_completion = query("runtime", "RESUME " + objective)
if replayed_completion != "COMPLETED":
    raise AssertionError(json.dumps({
        "replayed_completion": replayed_completion,
        "projection": json.loads(query("runtime", "INSPECT " + objective)),
        "journal": subprocess.check_output([
            "journalctl", "--no-pager", "-n", "80",
            "-u", "habitat-runtime.service", "-u", "habitat-state.service"
        ], text=True),
    }, sort_keys=True))
assert len(pg_effects(objective)[effect_id]["attempts"]) == 1
quota_after = authority_quota()
assert quota_after == quota_before

crash_stages = [
    "after-prepare", "before-pg-reserved", "after-pg-reserved",
    "before-authority-commit", "after-authority-commit", "before-dispatch",
]
for index, stage in enumerate(crash_stages):
    crash_objective = prepare("saga-" + stage)
    quota_before_crash = authority_quota().get("grant:runtime-conformance", 0)
    pathlib.Path(f"/run/habitat/effects/fault-{stage}").touch()
    assert query("runtime", "RESUME " + crash_objective) == "UNAVAILABLE"
    service("stop", "habitat-effects.service")
    service("reset-failed", "habitat-effects.service")
    service("stop", "habitat-authority.service")
    if index % 2 == 0:
        service("start", "habitat-authority.service")
        wait_ready("authority")
        service("reset-failed", "habitat-effects.service")
        service("start", "habitat-effects.service")
        wait_ready("effects")
    else:
        service("reset-failed", "habitat-effects.service")
        service("start", "habitat-effects.service")
        wait_ready("effects")
        service("start", "habitat-authority.service")
        wait_ready("authority")
        service("reset-failed", "habitat-effects.service")
        service("restart", "habitat-effects.service")
        wait_ready("effects")
    crash_deadline = time.monotonic() + 30
    crash_result = None
    while time.monotonic() < crash_deadline:
        crash_result = query("runtime", "RESUME " + crash_objective)
        if crash_result == "COMPLETED":
            break
        time.sleep(0.2)
    assert crash_result == "COMPLETED", (stage, crash_result)
    crash_effects = pg_effects(crash_objective)
    assert len(crash_effects) == 1
    crash_effect = next(iter(crash_effects.values()))
    assert len(crash_effect["attempts"]) == 1
    authority_after_crash = authority_snapshot()
    assert authority_after_crash["quota_usage"][
        "grant:runtime-conformance"] == quota_before_crash + 1
    assert authority_after_crash["effect_reservations"][
        "effect:" + crash_objective]["committed"] is True
    assert all(reservation["committed"] for reservation in
               authority_after_crash["effect_reservations"].values())

ambiguous = prepare("crash-after-dispatch")
pathlib.Path("/run/habitat/state/fault-after-effect-commit").touch()
assert query("runtime", "RESUME " + ambiguous) == "RECONCILIATION_REQUIRED"
before = pg_effects(ambiguous)
ambiguous_id = next(iter(before))
assert before[ambiguous_id]["record"]["state"] == "OutcomeUnknown"
service("stop", "habitat-state.service")
unavailable = wait_effect(
    ambiguous, ambiguous_id,
    lambda value: value[ambiguous_id]["record"]["state"] == "Reconciling"
    and value[ambiguous_id]["reconciliations"][-1]["observation_source"]
    == "postgresql-unavailable")
assert unavailable[ambiguous_id]["record"]["state"] == "Reconciling"
assert unavailable[ambiguous_id]["reconciliations"][-1]["observation_source"] == "postgresql-unavailable"
service("start", "habitat-state.service")
wait_ready("state", uid="habitat-runtime")
after = wait_effect(
    ambiguous, ambiguous_id,
    lambda value: value[ambiguous_id]["record"]["state"]
    == "ResolvedSucceeded")
assert after[ambiguous_id]["record"]["state"] == "ResolvedSucceeded"
assert 2 <= len(after[ambiguous_id]["reconciliations"]) <= 8
assert query("runtime", "RESUME " + ambiguous) == "COMPLETED"

compensation_objective = prepare("compensation")
assert query("runtime", "RESUME " + compensation_objective) == "COMPLETED"
before_compensation = pg_effects(compensation_objective)
compensation_original_id = next(iter(before_compensation))
assert json.loads(query("runtime", "INSPECT " + compensation_objective))[
    "objective_state"] == "SATISFIED"
assert query("runtime", "COMPENSATE " + compensation_objective + " "
             + compensation_original_id) == "COMPENSATED"
compensated = pg_effects(compensation_objective)
compensation = next(value["record"] for value in compensated.values()
                    if value["record"]["proposal"].get("compensates_effect_id")
                    == compensation_original_id)
assert compensation["state"] == "ObservedSucceeded"
compensated_projection = json.loads(
    query("runtime", "INSPECT " + compensation_objective))
assert compensated_projection["objective_state"] == "COMPENSATED"
assert compensated_projection["guard"]["ready"] is False
assert query("runtime", "RESUME " + compensation_objective) == "COMPENSATED"

failures = {}
authority_failure = prepare("authority-down")
service("stop", "habitat-authority.service")
failures["authority"] = query("runtime", "RESUME " + authority_failure)
assert failures["authority"] == "UNAVAILABLE"
service("start", "habitat-authority.service")
wait_ready("authority")

effects_failure = prepare("effects-down")
service("stop", "habitat-effects.service")
failures["effects"] = query("runtime", "RESUME " + effects_failure)
assert failures["effects"] == "UNAVAILABLE"
service("start", "habitat-effects.service")
wait_ready("effects")

postgres_failure = prepare("postgres-down")
postgres_quota_before = authority_quota()
service("stop", "postgresql.service")
failures["postgresql"] = query("runtime", "RESUME " + postgres_failure)
assert failures["postgresql"] == "UNAVAILABLE"
service("start", "postgresql.service")
wait_pg()
postgres_authority = authority_snapshot()
assert postgres_authority["quota_usage"] == postgres_quota_before
assert "effect:" + postgres_failure not in postgres_authority["effect_reservations"]
assert not pg_effects(postgres_failure)
service("restart", "habitat-effects.service")
wait_ready("effects")

garage_failure = prepare("garage-down")
garage_quota_before = authority_quota()
service("stop", "garage.service")
failures["garage"] = query("runtime", "RESUME " + garage_failure)
assert failures["garage"] == "UNAVAILABLE"
garage_authority = authority_snapshot()
garage_effects = pg_effects(garage_failure)
assert garage_authority["quota_usage"] != garage_quota_before
assert "effect:" + garage_failure in garage_authority["effect_reservations"]
assert len(garage_effects) == 1
assert next(iter(garage_effects.values()))["record"]["state"] == "OutcomeUnknown"
service("start", "garage.service")
service("restart", "habitat-effects.service")
wait_ready("effects")

revoke_objective = prepare("revoked")
admin = {
    "schema_version":"2.0", "operation":"revoke", "request_id":"admin:revoke",
    "caller_service_id":"service:operator",
    "grant_id":"grant:runtime-conformance", "state_version":None,
    "independent_approval":"approval:revoke",
}
admin_digest = "sha256:" + hashlib.sha256(json.dumps([
    admin["schema_version"], admin["operation"], admin["request_id"],
    admin["caller_service_id"], admin["grant_id"], admin["state_version"]
], separators=(",", ":")).encode()).hexdigest()
approval = {
    "schema_version":"2.0", "operation":"approve",
    "request_id":"approval:revoke", "caller_service_id":"service:reviewer",
    "grant_id":admin["request_id"], "state_version":admin_digest,
    "independent_approval":"",
}
assert json.loads(principal_query(
    "operator", "authority", json.dumps(approval), "habitat-operator"))["outcome"] == "UNAUTHORIZED"
assert json.loads(principal_query(
    "reviewer", "authority", json.dumps(admin), "habitat-reviewer"))["outcome"] == "UNAUTHORIZED"
approved = json.loads(principal_query("reviewer", "authority", json.dumps(approval), "habitat-reviewer"))
assert approved["outcome"] == "APPLIED"
revoked = json.loads(principal_query("operator", "authority", json.dumps(admin), "habitat-operator"))
assert revoked["outcome"] == "APPLIED"
assert json.loads(principal_query("operator", "authority", json.dumps(admin), "habitat-operator")) == revoked
assert query("runtime", "RESUME " + revoke_objective) == "UNAUTHORIZED"
service("restart", "habitat-authority.service")
wait_ready("authority")
assert query("runtime", "RESUME " + revoke_objective) == "UNAUTHORIZED"
admin.update({
    "operation":"rotate_state", "request_id":"admin:rotate",
    "grant_id":None, "state_version":"state:rotated",
    "independent_approval":"approval:rotate",
})
rotate_digest = "sha256:" + hashlib.sha256(json.dumps([
    admin["schema_version"], admin["operation"], admin["request_id"],
    admin["caller_service_id"], admin["grant_id"], admin["state_version"]
], separators=(",", ":")).encode()).hexdigest()
approval.update({"request_id":"approval:rotate", "grant_id":admin["request_id"],
                 "state_version":rotate_digest})
assert json.loads(principal_query("reviewer", "authority", json.dumps(approval), "habitat-reviewer"))["outcome"] == "APPLIED"
rotated = json.loads(principal_query("operator", "authority", json.dumps(admin), "habitat-operator"))
assert rotated["outcome"] == "APPLIED"
assert rotated["revocation_epoch"] > revoked["revocation_epoch"]

runtime_files = list(pathlib.Path("/var/lib/habitat/runtime").iterdir())
assert not runtime_files
print(json.dumps({
    "schema_version":"2.0", "event":"habitat.runtime_live",
    "outcome":"passed", "probes":{
        "forged_identity":"UNAUTHORIZED", "direct_state":"UNAUTHORIZED",
        "caller_subject":"UNAUTHORIZED", "same_uid_wrong_unit":"UNAUTHORIZED",
        "provider_mismatch":"UNAUTHORIZED", "duplicate_attempts":1,
        "quota_replay":"IDEMPOTENT", "compensation":"ObservedSucceeded",
        "safe_attestation":"SO_PEERCRED+EXACT_CGROUP+RUNTIME_HMAC",
        "restart_reconciliation":"ResolvedSucceeded",
        "reconciliation_unavailable":"Reconciling",
        "revocation_restart":"UNAUTHORIZED", "rotation_epoch":rotated["revocation_epoch"],
        "failures":failures, "objective_guard_count":state["guard"]["effect_count"],
        "runtime_effect_files":len(runtime_files),
        "transactional_store":"postgresql", "evidence_store":"garage-s3",
        "direct_pg":True, "direct_garage":True,
        "postgresql_attempt_count":len(ledger[effect_id]["attempts"]),
        "garage_tamper_rejected":True,
        "evidence_addressing":evidence_ref,
        "verified_evidence_digest":evidence_ref.rsplit("/", 1)[-1],
    }
}, sort_keys=True, separators=(",", ":")))
