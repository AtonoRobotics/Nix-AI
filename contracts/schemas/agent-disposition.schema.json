{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/schemas/agent-disposition/v1",
  "title": "Habitat Agent Disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation_id", "command_id", "kind", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "activation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "kind": {
      "type": "string",
      "enum": ["CONTEXT_REQUEST", "CAPABILITY_INVOCATION", "EFFECT_PROPOSAL", "DELEGATION", "MESSAGE", "CHECKPOINT", "SLEEP", "COMPLETION_CLAIM", "ACTIVATION_FAILURE"]
    },
    "payload": {"type": "object"},
    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_refs"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "CONTEXT_REQUEST"}}},
      "then": {"properties": {"payload": {"$ref": "https://habitat.invalid/schemas/context-request/v1"}}}
    }
  ]
}
