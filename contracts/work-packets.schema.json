{
  "$id": "https://nix-ai.invalid/contracts/work-packets-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dependency_semantics": {
      "additionalProperties": false,
      "properties": {
        "cannot_begin": {
          "type": "string"
        },
        "cannot_integrate": {
          "type": "string"
        },
        "cannot_pass": {
          "type": "string"
        }
      },
      "required": [
        "cannot_begin",
        "cannot_integrate",
        "cannot_pass"
      ],
      "type": "object"
    },
    "graph_id": {
      "const": "nix-ai-core-work-graph-v2.0.1"
    },
    "packets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cannot_begin": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "cannot_integrate": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "cannot_pass": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "deliverable": {
            "minLength": 1,
            "type": "string"
          },
          "gates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^W(?:0[0-9]|1[0-3])$",
            "type": "string"
          },
          "requirements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "deliverable",
          "requirements",
          "cannot_begin",
          "cannot_integrate",
          "cannot_pass",
          "gates"
        ],
        "type": "object"
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array"
    },
    "schema_version": {
      "const": 2
    },
    "source_authority": {
      "const": "contracts/v2.0.1/nix-ai-v2.0.1.contract.json"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "source_authority",
    "source_sha256",
    "dependency_semantics",
    "packets"
  ],
  "title": "Nix AI v2 work graph",
  "type": "object"
}
