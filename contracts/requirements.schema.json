{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat.invalid/contracts/requirements.schema.json",
  "title": "Habitat Requirement Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "expected_requirement_count", "criticality_definitions", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "expected_requirement_count": {"type": "integer", "minimum": 1},
    "criticality_definitions": {
      "type": "object",
      "required": ["critical", "release", "profile"],
      "additionalProperties": false,
      "properties": {
        "critical": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "criticality", "owner_packet", "implementation", "enforcement", "gates", "evidence", "acceptance"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["critical", "release", "profile"]},
          "owner_packet": {"type": "string", "pattern": "^W(?:0[0-9]|1[0-5])$"},
          "implementation": {"type": "string", "minLength": 1},
          "enforcement": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^V-[A-Z0-9-]+$"}},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "acceptance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
